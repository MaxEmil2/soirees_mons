# ╔═══════════════════════════════════════════════════════════════════╗
# ║                  SOIRÉES MONS - CONFIGURATION                      ║
# ║                                                                    ║
# ║  Copiez ce fichier vers .env et remplissez vos vraies valeurs     ║
# ║  Commande: cp .env.example .env                                   ║
# ╚═══════════════════════════════════════════════════════════════════╝

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Récupérez ces valeurs depuis Firebase Console > Project Settings > Your apps > Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ========================================
# STRIPE CONFIGURATION
# ========================================
# Récupérez ces valeurs depuis Stripe Dashboard > Developers > API keys

# Clé secrète Stripe (à mettre dans Firebase Functions Config)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secret du webhook Stripe (après avoir créé le webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# URL de votre application (pour les redirections Stripe)
APP_URL=http://localhost:5173

# ========================================
# EMULATORS (DÉVELOPPEMENT)
# ========================================

# Utiliser les émulateurs Firebase en développement
VITE_USE_EMULATORS=false

# ========================================
# NOTES IMPORTANTES
# ========================================

# 🔒 SÉCURITÉ:
# - Ne commitez JAMAIS le fichier .env sur Git
# - Le .gitignore doit contenir .env
# - En production, utilisez les variables d'environnement de votre hébergeur

# 🚀 DÉPLOIEMENT:
# 1. Frontend: Les variables VITE_* sont intégrées au build
# 2. Backend (Functions): Utilisez `firebase functions:config:set`
#    Exemple: firebase functions:config:set stripe.secret_key="sk_live_xxx"

# 📝 Pour configurer les Cloud Functions en production:
# firebase functions:config:set stripe.secret_key="sk_live_your_key"
# firebase functions:config:set stripe.webhook_secret="whsec_your_secret"
# firebase functions:config:set app.url="https://votre-domaine.com"
