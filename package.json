{
  "name": "soirees-mons",
  "version": "2.0.0",
  "description": "Plateforme ultra-sécurisée et optimisée pour la gestion d'événements à Mons",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "functions:dev": "firebase emulators:start",
    "functions:deploy": "firebase deploy --only functions",
    "deploy": "npm run build && firebase deploy",
    "lint": "eslint src functions",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"functions/**/*.js\""
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "qrcode": "^1.5.3",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
